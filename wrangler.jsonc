{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "small-tools",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Let the Worker handle /api/* before the SPA fallback serves index.html.
    "run_worker_first": ["/api/*"]
  }
  // Secrets (set with `wrangler secret put`): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ASSETS_PASSWORD
}
